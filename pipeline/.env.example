# Copy to .env (never commit .env)
# Path to the Google service account JSON key, relative to pipeline/
GOOGLE_KEY_FILE=../.secrets/service-account.json

# MNC - Content Plan
CONTENT_PLAN_SHEET_ID=
CONTENT_PLAN_TAB=Content Plan
# MNC - Project Checklist (only used by `npm run setup-sheets`)
CHECKLIST_SHEET_ID=

# Drive folders
DRAFTS_FOLDER_ID=
ASSETS_FOLDER_ID=

# Public site URL (used for Live URL in the sheet). Update after the domain is connected.
SITE_URL=https://example.com
