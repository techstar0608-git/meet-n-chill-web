---
// Shared landing template for /hope-kids, /ablaze, /young-pro. Copy lives in src/config/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from './PostGrid.astro';
import JoinCta from './JoinCta.astro';
import Media from './Media.astro';
import Gallery from './Gallery.astro';
import Quote from './Quote.astro';
import { getGroup, type GroupKey } from '../config/site';
import { getPosts } from '../lib/posts';

interface Props { groupKey: GroupKey }
const group = getGroup(Astro.props.groupKey)!;
const k = group.key;
const posts = (await getPosts(k)).slice(0, 3);
const acts = group.activities.length;
---
<BaseLayout title={group.name} description={`${group.name} (${group.ages}): ${group.intro}`} group={k}>
  <!-- HERO: mobile = photo on top (4:3), desktop = text left / portrait photo right (5:6) -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-media">
        <Media id={`${k}-hero`} m={[1200, 900]} d={[1000, 1200]} eager
          label={`Ảnh hero ${group.name} — khoảnh khắc đẹp nhất của nhóm (chủ thể ở giữa)`} alt={`${group.name} activity`} />
      </div>
      <div class="hero-text">
        <p class="eyebrow">{group.ages}</p>
        <h1>{group.name}</h1>
        <p class="lead">{group.tagline}</p>
        <p>{group.intro}</p>
        <div class="actions">
          <a class="btn" href={group.joinUrl}>{group.joinLabel}</a>
          <a class="btn btn--ghost" href="#video">Watch the video</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="container">
    <dl class="facts">
      {group.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
  </section>

  <!-- ACTIVITIES: swipe on mobile -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Activities</h2>
      <div class="scroller" style={`--cols: ${acts}; --cols-md: ${acts === 5 ? 3 : 2}; --item: 76%`}>
        {group.activities.map((a, i) => (
          <article class="card act">
            <Media id={`${k}-activity-${i + 1}`} m={[800, 600]} label={`Ảnh hoạt động: ${a.title}`} alt={a.title} />
            <div class="act-body">
              <h3><span aria-hidden="true">{a.icon}</span> {a.title}</h3>
              <p class="muted">{a.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO: 16:9 on every screen -->
  <section class="section section--tint" id="video">
    <div class="container video-wrap">
      <div>
        <p class="eyebrow">See it for yourself</p>
        <h2>A day at {group.name}</h2>
        <p class="muted">A short look at what a typical session feels like.</p>
      </div>
      <Media id={`${k}-video`} kind="video" m={[1920, 1080]}
        label={`Video giới thiệu ${group.name} — 60–90s (sẽ đổi sang player có tiếng khi có video)`} alt={`Video about ${group.name}`} />
    </div>
  </section>

  <!-- A TYPICAL SESSION -->
  <section class="section">
    <div class="container flow-grid">
      <div>
        <p class="eyebrow">{group.schedule}</p>
        <h2>A typical session</h2>
        <ol class="flow">
          {group.flow.map((f) => (
            <li><span class="time">{f.time}</span><div><strong>{f.title}</strong><p class="muted">{f.text}</p></div></li>
          ))}
        </ol>
      </div>
      <div class="flow-media">
        <Media id={`${k}-session`} m={[1200, 900]} d={[1000, 1250]} label="Ảnh trong buổi sinh hoạt (chủ thể ở giữa)" alt={`${group.name} session`} />
      </div>
    </div>
  </section>

  <Gallery prefix={k} title={`${group.name} moments`} label={`Ảnh gallery ${group.name}`} />

  <!-- TEAM + TESTIMONIAL -->
  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">Who you’ll meet</p>
      <h2>Our team</h2>
      <div class="team">
        <ul class="leaders">
          {group.leaders.map((l, i) => (
            <li class="leader">
              <Media id={`${k}-leader-${i + 1}`} m={[600, 600]} label={`Chân dung ${l.role}`} alt={l.name} />
              <strong>{l.name}</strong>
              <span class="muted">{l.role}</span>
            </li>
          ))}
        </ul>
        <Quote id={`${k}-quote-avatar`} group={k} {...group.testimonial} />
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section">
    <div class="container">
      <h2>Latest from {group.name}</h2>
      <PostGrid posts={posts} />
      {posts.length > 0 && <p><a href={`/blog/${k}/`}>All {group.name} stories →</a></p>}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tint">
    <div class="container faq">
      <h2>Questions</h2>
      {group.faq.map((f) => (
        <details class="card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container"><JoinCta group={group} /></div>
  </section>
</BaseLayout>

<style>
  /* ---------- Mobile (default) ---------- */
  .hero { background: linear-gradient(180deg, var(--accent-soft), transparent); padding: 20px 0 40px; }
  .hero-grid { display: grid; gap: 24px; }
  .actions { display: grid; gap: 10px; margin-top: 20px; }
  .actions .btn { justify-content: center; }

  .facts { display: grid; grid-template-columns: 1fr 1fr; margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .facts div { padding: 14px 16px; }
  .facts div:nth-child(even) { border-left: 1px solid var(--line); }
  .facts div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 800; color: var(--accent); }
  dd { margin: 2px 0 0; font-weight: 800; }

  .act { padding: 0; height: 100%; }
  .act :global(.media) { border-radius: var(--radius) var(--radius) 0 0; }
  .act-body { padding: 16px 18px 18px; }
  .act-body h3 { margin: 0 0 4px; font-size: 1.1rem; }
  .act-body p { margin: 0; font-size: 0.95rem; }

  .video-wrap { display: grid; gap: 20px; }

  .flow-grid { display: grid; gap: 24px; }
  .flow { list-style: none; margin: 16px 0 0; padding: 0; }
  .flow li { display: grid; grid-template-columns: 58px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px dashed var(--line); }
  .time { font-weight: 900; color: var(--accent); }
  .flow p { margin: 2px 0 0; font-size: 0.95rem; }

  .team { display: grid; gap: 20px; }
  .leaders { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .leader { display: grid; gap: 2px; align-content: start; text-align: center; font-size: 0.85rem; }
  .leader :global(.media) { border-radius: 50%; margin-bottom: 6px; }
  .leader :global(.ph-info) { display: none; }

  .faq { display: grid; gap: 12px; max-width: 800px; }
  summary { font-weight: 800; cursor: pointer; min-height: 28px; }

  /* ---------- Tablet ---------- */
  @media (min-width: 768px) {
    .hero { padding: 56px 0 72px; }
    .hero-grid { grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; }
    .hero-media { order: 2; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
    .facts { grid-template-columns: repeat(4, 1fr); }
    .facts div { padding: 20px 24px; }
    .facts div:nth-child(n) { border-top: 0; border-left: 1px solid var(--line); }
    .facts div:first-child { border-left: 0; }
    dd { font-size: 1.1rem; }
    .flow-grid { grid-template-columns: 1.2fr 0.8fr; gap: 48px; align-items: center; }
    .flow li { grid-template-columns: 72px 1fr; gap: 16px; padding: 14px 0; }
    .time { font-size: 1.1rem; }
    .leader { text-align: left; font-size: 1rem; }
    .leader :global(.media) { border-radius: var(--radius); }
    .leader :global(.ph-info) { display: grid; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 1024px) {
    .team { grid-template-columns: 3fr 1.3fr; align-items: stretch; }
  }
</style>
