---
import { SITE, GROUPS } from '../config/site';
const year = new Date().getFullYear();
const builtAt = new Date().toLocaleString('en-AU', { timeZone: 'Asia/Ho_Chi_Minh', dateStyle: 'medium', timeStyle: 'short' });
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="brand">{SITE.name}</p>
      <p class="muted">{SITE.tagline}</p>
    </div>
    <div>
      <p class="h">Groups</p>
      <ul>{GROUPS.map((g) => <li><a href={`/${g.key}/`}>{g.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="h">More</p>
      <ul>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/about/">About &amp; contact</a></li>
        <li><a href="/privacy/">Privacy &amp; photos</a></li>
        {SITE.socials.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <p class="container copy muted">© {year} {SITE.name}{SITE.demo && ` · Preview · updated ${builtAt}`}</p>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding: 48px 0 24px; margin-top: 48px; }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .brand { font-weight: 900; font-size: 1.2rem; margin: 0 0 4px; }
  .h { font-weight: 800; margin: 0 0 8px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  a { color: var(--ink); }
  .copy { font-size: 0.85rem; margin-top: 32px; }
</style>
