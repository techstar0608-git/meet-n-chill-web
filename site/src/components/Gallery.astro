---
import Media from './Media.astro';
interface Props { prefix: string; title?: string; label: string }
const { prefix, title = 'Moments', label } = Astro.props;
// Mobile: 1 wide photo (4:3) + 2×2 squares. Desktop: bento — big square (2×2) + 4 squares.
// Tile 1 is shot square (1600×1600) so it crops cleanly to 4:3 on mobile.
---
<section class="section">
  <div class="container">
    <h2>{title}</h2>
    <div class="gallery">
      <div class="tile big">
        <Media id={`${prefix}-gallery-1`} m={[1600, 1200]} d={[1600, 1600]} label={`${label} #1 (chụp vuông, chủ thể ở giữa)`} alt={`${label} photo 1`} />
      </div>
      {[2, 3, 4, 5].map((n) => (
        <div class="tile">
          <Media id={`${prefix}-gallery-${n}`} m={[800, 800]} label={`${label} #${n}`} alt={`${label} photo ${n}`} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .big { grid-column: 1 / -1; }
  @media (min-width: 768px) {
    .gallery { gap: 14px; grid-template-columns: repeat(4, 1fr); }
    .big { grid-column: span 2; grid-row: span 2; }
  }
</style>
