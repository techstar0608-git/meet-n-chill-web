---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

// scroll: swipe carousel on mobile, 3-column grid from tablet up.
interface Props { posts: Post[]; empty?: string; scroll?: boolean }
const { posts, empty = 'New stories are coming soon.', scroll = false } = Astro.props;
---
{posts.length
  ? <div class={scroll ? 'scroller' : 'grid'} style={scroll ? '--cols: 3; --cols-md: 3; --item: 84%' : undefined}>{posts.map((post) => <PostCard post={post} />)}</div>
  : <p class="muted">{empty}</p>}
