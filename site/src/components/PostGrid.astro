---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props { posts: Post[]; empty?: string }
const { posts, empty = 'New stories are coming soon.' } = Astro.props;
---
{posts.length
  ? <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
  : <p class="muted">{empty}</p>}
