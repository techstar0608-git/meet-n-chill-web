---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE, GROUPS } from '../config/site';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 6);
const activities = [
  { icon: '🛠️', title: 'Workshops' },
  { icon: '🌿', title: 'Outdoor activities' },
  { icon: '🍲', title: 'Dinners together' },
  { icon: '🗣️', title: 'English practice' },
  { icon: '💬', title: 'Life & work sharing' },
];
---
<BaseLayout>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Welcome to {SITE.name}</p>
      <h1>{SITE.tagline}</h1>
      <p class="lead">{SITE.description}</p>
      <ul class="acts">
        {activities.map((a) => <li><span aria-hidden="true">{a.icon}</span> {a.title}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Find your group</h2>
      <div class="grid groups">
        {GROUPS.map((g) => (
          <a class="card group" data-group={g.key} href={`/${g.key}/`}>
            <span class="chip">{g.ages}</span>
            <h3>{g.name}</h3>
            <p class="muted">{g.tagline}</p>
            <span class="more">Discover {g.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2>Latest stories</h2>
      <PostGrid posts={latest} />
      <p><a href="/blog/">Read the blog →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: radial-gradient(1200px 400px at 10% 0%, var(--hk-soft), transparent), radial-gradient(900px 400px at 90% 10%, var(--yp-soft), transparent); }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 28px 0 0; }
  .acts li { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; font-weight: 700; }
  .group { text-decoration: none; color: var(--ink); border-top: 6px solid var(--accent); display: grid; gap: 8px; justify-items: start; transition: transform 0.15s ease; }
  .group:hover { transform: translateY(-4px); }
  .group h3, .group p { margin: 0; }
  .more { color: var(--accent); font-weight: 800; }
</style>
