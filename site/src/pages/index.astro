---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import Media from '../components/Media.astro';
import Gallery from '../components/Gallery.astro';
import Quote from '../components/Quote.astro';
import { SITE, GROUPS, EVENTS, getCategory } from '../config/site';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
const activities = [
  { id: 'home-activity-workshop', title: 'Workshops', text: 'Hands-on sessions to learn real skills.' },
  { id: 'home-activity-outdoor', title: 'Outdoor activities', text: 'Hikes, picnics, camps and games.' },
  { id: 'home-activity-dinner', title: 'Dinners together', text: 'Good food and even better conversations.' },
  { id: 'home-activity-english', title: 'English practice', text: 'Relaxed groups for every level.' },
  { id: 'home-activity-sharing', title: 'Life & work sharing', text: 'Listen, share and get honest advice.' },
];
const day = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric' });
const month = (d: string) => new Date(d).toLocaleDateString('en-GB', { month: 'short' });
---
<BaseLayout>
  <!-- HERO: background video. Mobile 4:5 portrait, desktop 16:9 -->
  <section class="hero">
    <Media id="home-hero" kind="video" m={[1080, 1350]} d={[1920, 1080]} fill eager
      label="Video hero trang chủ — cảnh sinh hoạt 3 nhóm, 15–30s, không tiếng"
      alt="Members of Meet n Chill enjoying activities together" class="bg" />
    <div class="shade"></div>
    <div class="container hero-content">
      <p class="eyebrow">Welcome to {SITE.name}</p>
      <h1>{SITE.tagline}</h1>
      <p class="lead">{SITE.description}</p>
      <div class="actions">
        <a class="btn" href="#groups">Find your group</a>
        <a class="btn btn--light" href="/blog/">See our stories</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="container">
    <dl class="stats">
      {SITE.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </section>

  <!-- GROUPS: swipe on mobile, 3 columns on desktop -->
  <section class="section" id="groups">
    <div class="container">
      <p class="eyebrow">Three groups, one family</p>
      <h2>Find your group</h2>
      <div class="scroller" style="--cols: 3; --cols-md: 3; --item: 82%">
        {GROUPS.map((g) => (
          <a class="group" data-group={g.key} href={`/${g.key}/`}>
            <Media id={`home-group-${g.key}`} m={[800, 1000]} label={`Ảnh đại diện nhóm ${g.name} (dọc)`} alt={`${g.name} members`} />
            <div class="group-body">
              <span class="chip">{g.ages}</span>
              <h3>{g.name}</h3>
              <p>{g.tagline}</p>
              <span class="more">Discover {g.name} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ACTIVITIES: swipe on mobile, 5 columns on desktop -->
  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Something for every week</h2>
      <div class="scroller" style="--cols: 5; --cols-md: 3; --item: 64%">
        {activities.map((a) => (
          <article class="act">
            <Media id={a.id} m={[800, 800]} d={[800, 1000]} label={`Ảnh hoạt động: ${a.title}`} alt={a.title} />
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- UPCOMING -->
  <section class="section">
    <div class="container upcoming">
      <div class="up-intro">
        <p class="eyebrow">Coming up</p>
        <h2>Upcoming activities</h2>
        <p class="muted">New here? Just come along — every activity is open to first-timers.</p>
      </div>
      <ul class="events">
        {EVENTS.map((e) => (
          <li class="event" data-group={e.group}>
            <div class="date"><strong>{day(e.date)}</strong><span>{month(e.date)}</span></div>
            <div>
              <span class="chip">{getCategory(e.group)?.name}</span>
              <h3>{e.title}</h3>
              <p class="muted">{e.place}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="up-media">
        <Media id="home-upcoming" m={[1200, 900]} label="Ảnh không khí buổi sinh hoạt" alt="A Meet n Chill activity" />
      </div>
    </div>
  </section>

  <Gallery prefix="home" title="Moments from our community" label="Ảnh gallery trang chủ" />

  <!-- TESTIMONIALS -->
  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">In their words</p>
      <h2>What people say</h2>
      <div class="scroller" style="--cols: 3; --cols-md: 3; --item: 86%">
        {GROUPS.map((g) => <Quote id={`${g.key}-quote-avatar`} group={g.key} {...g.testimonial} />)}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <div><p class="eyebrow">From the blog</p><h2>Latest stories</h2></div>
        <a class="all" href="/blog/">All stories →</a>
      </div>
      <PostGrid posts={latest} scroll />
    </div>
  </section>

  <!-- JOIN BAND: mobile 4:5, desktop 12:5 -->
  <section class="join">
    <Media id="home-join-band" m={[1080, 1350]} d={[1920, 800]} fill
      label="Ảnh nền banner cuối trang — ảnh nhóm đông người, vui vẻ" alt="" class="bg" />
    <div class="shade shade--flat"></div>
    <div class="container join-content">
      <h2>Ready to meet new friends?</h2>
      <p>Pick your group and join us this week. Everyone is welcome.</p>
      <div class="actions">
        {GROUPS.map((g) => <a class="btn btn--light" href={`/${g.key}/`}>{g.name}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Mobile (default) ---------- */
  .hero, .join { position: relative; isolation: isolate; color: #fff; overflow: hidden; }
  .hero :global(.bg), .join :global(.bg) { position: absolute; inset: 0; z-index: -2; border-radius: 0; }
  .hero :global(.bg .ph-info), .join :global(.bg .ph-info) { position: absolute; top: 16px; left: 16px; right: 16px; max-width: none; }
  .shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgb(20 16 30 / 0) 25%, rgb(20 16 30 / 0.78)); }
  .shade--flat { background: rgb(20 16 30 / 0.55); }

  .hero { min-height: min(92svh, 720px); display: grid; align-items: end; }
  .hero-content { padding: 160px 0 64px; }
  .hero-content .eyebrow { color: #ffd79a; }
  .hero-content .lead { color: rgb(255 255 255 / 0.9); font-size: 1.05rem; }
  .actions { display: grid; gap: 10px; margin-top: 20px; }
  .actions .btn { justify-content: center; }
  :global(.btn--light) { background: #fff; color: var(--ink); border-color: #fff; }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 8px; margin: -32px 0 0; position: relative;
    background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px 12px; }
  .stats div { display: flex; flex-direction: column-reverse; text-align: center; }
  .stats dd { margin: 0; font-size: 1.8rem; font-weight: 900; color: var(--accent); line-height: 1.1; }
  .stats dt { color: var(--muted); font-size: 0.85rem; }

  .group { position: relative; display: block; color: #fff; text-decoration: none; border-radius: var(--radius); overflow: hidden; }
  .group-body { position: absolute; inset: auto 0 0 0; padding: 20px; display: grid; gap: 6px; justify-items: start;
    background: linear-gradient(180deg, transparent, rgb(20 16 30 / 0.85)); }
  .group-body h3 { font-size: 1.5rem; margin: 0; }
  .group-body p { margin: 0; color: rgb(255 255 255 / 0.9); font-size: 0.95rem; }
  .group-body .chip { background: var(--accent); color: #fff; }
  .more { font-weight: 800; }
  .group :global(img) { transition: transform 0.4s ease; }
  .group:hover :global(img) { transform: scale(1.03); }

  .act h3 { margin: 12px 0 2px; font-size: 1.1rem; }
  .act p { margin: 0; font-size: 0.95rem; }

  .upcoming { display: grid; gap: 20px; }
  .events { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .event { display: flex; gap: 14px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; }
  .date { display: grid; place-items: center; min-width: 56px; padding: 8px 6px; border-radius: 14px; background: var(--accent-soft); color: var(--accent); line-height: 1.1; }
  .date strong { font-size: 1.4rem; font-weight: 900; }
  .date span { text-transform: uppercase; font-weight: 800; font-size: 0.75rem; }
  .event h3 { margin: 6px 0 0; font-size: 1.05rem; }
  .event p { margin: 0; font-size: 0.9rem; }

  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 8px; }
  .all { white-space: nowrap; font-weight: 700; }

  .join { min-height: 560px; display: grid; align-items: end; }
  .join-content { padding: 150px 0 56px; text-align: center; }
  .join-content p { color: rgb(255 255 255 / 0.9); }

  /* ---------- Tablet ---------- */
  @media (min-width: 768px) {
    .hero { min-height: min(86vh, 760px); }
    .hero :global(.bg .ph-info) { top: 96px; left: auto; max-width: 360px; }
    .hero-content { padding: 140px 0 88px; }
    .hero-content h1 { max-width: 16ch; }
    .hero-content .lead { font-size: 1.2rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
    .join-content .actions { justify-content: center; }
    .stats { grid-template-columns: repeat(4, 1fr); padding: 24px; margin-top: -44px; }
    .stats dd { font-size: 2.3rem; }
    .upcoming { grid-template-columns: 1fr 1fr; gap: 24px 40px; align-items: start; }
    .up-intro { grid-column: 1 / -1; }
    .event { padding: 16px 18px; }
    .join { min-height: 0; align-items: center; }
    .join-content { padding: 110px 0; }
    .join :global(.bg .ph-info) { left: auto; max-width: 360px; }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 1024px) {
    .upcoming { grid-template-columns: 1fr 1.1fr; grid-template-rows: auto 1fr; }
    .up-intro { grid-column: 1; }
    .up-media { grid-column: 1; grid-row: 2; }
    .events { grid-column: 2; grid-row: 1 / span 2; }
    .group-body { padding: 24px; }
    .group-body h3 { font-size: 1.6rem; }
  }
</style>
