---
import Media from '../../../components/Media.astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JoinCta from '../../../components/JoinCta.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { getCategory, getGroup } from '../../../config/site';
import { getPosts, formatDate, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { category: post.data.category, slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { title, description, date, eventDate, category, author, cover, coverAlt, tags } = post.data;
const { Content } = await render(post);
const group = getGroup(category);
const related = (await getPosts(category)).filter((p) => p.id !== post.id).slice(0, 3);
---
<BaseLayout title={title} description={description} group={category} image={cover?.src}>
  <article class="section">
    <div class="container">
      <header class="head">
        <a class="chip" href={`/blog/${category}/`}>{getCategory(category)?.name}</a>
        <h1>{title}</h1>
        <p class="muted">
          By {author} · <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {eventDate && <> · Event on {formatDate(eventDate)}</>}
        </p>
      </header>
      <div class="cover"><Media id={`blog-cover-${post.id}`} src={cover} m={[1600, 900]} label="Ảnh cover bài viết (pipeline lấy từ Drive 03_Blog Assets)" alt={coverAlt ?? title} eager /></div>
      <div class="prose"><Content /></div>
      {tags.length > 0 && <p class="prose tags">{tags.map((t) => <span class="chip">#{t}</span>)}</p>}
    </div>
  </article>

  {group && <div class="container"><JoinCta group={group} /></div>}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>More from {getCategory(category)?.name}</h2>
        <PostGrid posts={related} />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .head { max-width: 70ch; margin: 0 auto 24px; display: grid; gap: 8px; justify-items: start; }
  .head h1 { margin: 0; }
  .cover { max-width: 1000px; margin: 0 auto 32px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
</style>
